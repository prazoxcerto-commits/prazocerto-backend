<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>PrazoX – Controle de Validade Premium</title>
  <meta name="description" content="PrazoX: o app premium de controle de datas de validade com leitura de código de barras, alertas inteligentes e dashboard moderNão." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
  <style>
    /* Forçar visual de celular (Mobile Viewport) Não Desktop */
    @media (min-width: 600px) {
      body {
        background-color: var(--primary);
      }
      body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        display: flex;
        justify-content: center;
        pointer-events: none;
        z-index: -1;
      }
      .app-container, .splash-screen, .bottom-nav {
        max-width: 414px !important;
        width: 100% !important;
        margin: 0 auto !important;
        box-shadow: 0 0 30px rgba(0,0,0,0.8);
        border-left: 1px solid #334155;
        border-right: 1px solid #334155;
        left: 0 !important;
        right: 0 !important;
      }
      .bottom-nav {
        position: fixed !important;
        bottom: 0 !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
      }
      .sidebar {
        display: none !important;
      }
      .menu-toggle {
        display: block !important;
      }
    }
  </style>
  <!-- Export Libraries -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</head>
<body>

<!-- SPLASH + LOGIN SCREEN -->
<div id="splash" class="splash-screen">
  <div class="splash-content" style="justify-content:center; gap:1.5rem; padding: 20px;">
    <!-- ControlVald Logo SVG -->
    <div style="text-align:center; padding-top:10px;">
      <div class="controlvald-anim-logo" style="display:flex; justify-content:center;">
        <svg viewBox="-20 -20 240 240" width="120" height="120" style="overflow:visible;">
          <defs>
            <linearGradient id="cvGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#00E5FF"/>
              <stop offset="100%" stop-color="#3B82F6"/>
            </linearGradient>
            <filter id="neonGlow">
              <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
              <feMerge>
                <feMergeNãode in="coloredBlur"/>
                <feMergeNãode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
          <polygon points="100,20 180,60 180,160 100,200 20,160 20,60" fill="none" stroke="url(#cvGrad)" stroke-width="4" filter="url(#neonGlow)" />
          <path d="M120,80 L80,110 L120,140" fill="none" stroke="#00E5FF" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" filter="url(#neonGlow)" />
          <path d="M100,70 L140,110 L100,150" fill="none" stroke="#3B82F6" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" filter="url(#neonGlow)" />
        </svg>
      </div>
      <div style="font-size: 1.8rem; font-weight: 900; color: #fff; text-shadow: 0 0 10px #00E5FF; margin-top: 15px;">Control<span style="color:#00E5FF">Vald</span></div>
      <p style="color:var(--text-2); font-size:0.8rem; margin:5px 0 0;">Gestão de Validade Inteligente</p>
    </div>

    <!-- Auth Forms Container -->
    <div id="authBox" style="width:100%; max-width:320px; background:var(--bg-card); border:1px solid var(--border); border-radius:16px; padding:1.5rem; box-sizing:border-box; position:relative; overflow:hidden;">
      
      <!-- LOADING OVERLAY -->
      <div id="authLoading" style="display:none; position:absolute; inset:0; background:rgba(10,10,15,0.8); z-index:10; align-items:center; justify-content:center; flex-direction:column;">
        <div class="loader-bar" style="width:150px;"><div class="loader-fill"></div></div>
        <p style="color:var(--text-2); font-size:0.85rem; margin-top:10px;">Autenticando...</p>
      </div>

      <p id="authErrorMsg" style="color:var(--danger); font-size:0.85rem; margin:0 0 10px 0; min-height:1.2em; text-align:center;"></p>
      <!-- LOGIN FORM -->
      <div id="formLogin">
        <h2 style="margin:0 0 1.2rem; color:var(--text-1); font-size:1.1rem; text-align:center;">Entrar na sua conta</h2>
        <div style="display:flex; flex-direction:column; gap:0.8rem;">
          <input id="loginEmail" type="email" placeholder="E-mail"
            style="width:100%; padding:0.7rem 0.9rem; background:var(--bg-3); border:1px solid var(--border); border-radius:8px; color:var(--text-1); font-size:0.9rem; box-sizing:border-box; outline:none; text-align:center;">
          <input id="loginPassword" type="password" placeholder="Senha"
            style="width:100%; padding:0.7rem 0.9rem; background:var(--bg-3); border:1px solid var(--border); border-radius:8px; color:var(--text-1); font-size:0.9rem; box-sizing:border-box; outline:none; text-align:center;">
          
          <div style="text-align:center;">
            <a href="javascript:void(0)" onclick="toggleAuthForm('forgot')" style="color:var(--primary); font-size:0.8rem; text-decoration:none;">Esqueci a senha</a>
          </div>

          
          
          <button onclick="handleEmailLogin()" style="padding:0.8rem; background:var(--gradient-main); border:none; border-radius:10px; color:#000; font-weight:800; font-size:0.95rem; cursor:pointer; width:100%;">Entrar</button>
          
          <div style="text-align:center; margin:5px 0;">
            <span style="color:var(--text-2); font-size:0.8rem;">ou</span>
          </div>

          <button onclick="handleGoogleLogin()" style="padding:0.7rem; background:#fff; border:none; border-radius:10px; color:#333; font-weight:700; font-size:0.9rem; cursor:pointer; width:100%; display:flex; align-items:center; justify-content:center; gap:8px;">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="18" height="18" alt="G"> Entrar com Google
          </button>
          
          <div style="text-align:center; margin-top:10px; border-top:1px solid var(--border); padding-top:10px;">
            <span style="color:var(--text-2); font-size:0.85rem;">Não tem conta? </span>
            <a href="javascript:void(0)" onclick="toggleAuthForm('register')" style="color:var(--primary); font-size:0.85rem; text-decoration:none; font-weight:bold;">Criar conta</a>
          </div>
        </div>
      </div>

      <!-- REGISTER FORM -->
      <div id="formRegister" style="display:none;">
        <h2 style="margin:0 0 1.2rem; color:var(--text-1); font-size:1.1rem; text-align:center;">Criar nova conta</h2>
        <div style="display:flex; flex-direction:column; gap:0.8rem;">
          <input id="regName" type="text" placeholder="Nãome Completo"
            style="width:100%; padding:0.7rem 0.9rem; background:var(--bg-3); border:1px solid var(--border); border-radius:8px; color:var(--text-1); font-size:0.9rem; box-sizing:border-box; outline:none; text-align:center;">
          <input id="regEmail" type="email" placeholder="E-mail"
            style="width:100%; padding:0.7rem 0.9rem; background:var(--bg-3); border:1px solid var(--border); border-radius:8px; color:var(--text-1); font-size:0.9rem; box-sizing:border-box; outline:none; text-align:center;">
          <input id="regPassword" type="password" placeholder="Senha (min 6 chars)"
            style="width:100%; padding:0.7rem 0.9rem; background:var(--bg-3); border:1px solid var(--border); border-radius:8px; color:var(--text-1); font-size:0.9rem; box-sizing:border-box; outline:none; text-align:center;">
          
          <button onclick="handleEmailRegister()" style="padding:0.8rem; background:var(--gradient-main); border:none; border-radius:10px; color:#000; font-weight:800; font-size:0.95rem; cursor:pointer; width:100%; margin-top:5px;">Cadastrar</button>
          
          <div style="text-align:center; margin-top:10px;">
            <a href="javascript:void(0)" onclick="toggleAuthForm('login')" style="color:var(--text-2); font-size:0.85rem; text-decoration:none;">⬅ Voltar para Login</a>
          </div>
        </div>
      </div>

      <!-- FORGOT PASSWORD FORM -->
      <div id="formForgot" style="display:none;">
        <h2 style="margin:0 0 1.2rem; color:var(--text-1); font-size:1.1rem; text-align:center;">Recuperar Senha</h2>
        <p style="color:var(--text-2); font-size:0.8rem; text-align:center; margin-top:0;">Digite seu e-mail para receber um link de redefinição.</p>
        <div style="display:flex; flex-direction:column; gap:0.8rem;">
          <input id="forgotEmail" type="email" placeholder="E-mail"
            style="width:100%; padding:0.7rem 0.9rem; background:var(--bg-3); border:1px solid var(--border); border-radius:8px; color:var(--text-1); font-size:0.9rem; box-sizing:border-box; outline:none; text-align:center;">
          
          <button onclick="handlePasswordReset()" style="padding:0.8rem; background:var(--primary); border:none; border-radius:10px; color:#000; font-weight:800; font-size:0.95rem; cursor:pointer; width:100%; margin-top:5px;">Enviar Link</button>
          
          <div style="text-align:center; margin-top:10px;">
            <a href="javascript:void(0)" onclick="toggleAuthForm('login')" style="color:var(--text-2); font-size:0.85rem; text-decoration:none;">⬅ Voltar para Login</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- APP CONTAINER -->
<div id="app" class="app-container hidden">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <div class="logo-mark" style="display:flex; align-items:center; transform:scale(0.5); transform-origin:left center; margin-right: -40px;">
        <svg viewBox="0 0 200 200" width="100" height="100" style="overflow:visible;">
          <defs>
            <linearGradient id="cvGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#00E5FF"/>
              <stop offset="100%" stop-color="#3B82F6"/>
            </linearGradient>
            <filter id="neonGlow">
              <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
              <feMerge>
                <feMergeNãode in="coloredBlur"/>
                <feMergeNãode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
          <polygon points="100,10 180,50 180,150 100,190 20,150 20,50" fill="none" stroke="url(#cvGrad)" stroke-width="4" filter="url(#neonGlow)" />
          <path d="M120,70 L80,100 L120,130" fill="none" stroke="#00E5FF" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" filter="url(#neonGlow)" />
          <path d="M100,60 L140,100 L100,140" fill="none" stroke="#3B82F6" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" filter="url(#neonGlow)" />
        </svg>
        <div style="font-size: 2.2rem; font-weight: 900; color: #fff; text-shadow: 0 0 10px #00E5FF; margin-left: 10px;">Control<span style="color:#00E5FF">Vald</span></div>
      </div>
      
      <button class="sidebar-close" id="sidebarClose">✕</button>
    </div>

    <nav class="sidebar-nav">
      <a class="nav-item active" data-page="dashboard" id="nav-dashboard">
        <span class="nav-icon">📊</span>
        <span>Dashboard</span>
      </a>
      <a class="nav-item" data-page="products" id="nav-products">
        <span class="nav-icon">📦</span>
        <span>Produtos</span>
        <span class="nav-badge" id="badge-products">0</span>
      </a>
      <a class="nav-item" data-page="alerts" id="nav-alerts">
        <span class="nav-icon">🔔</span>
        <span>Alertas</span>
        <span class="nav-badge danger" id="badge-alerts">0</span>
      </a>
      <a class="nav-item" data-page="scanner" id="nav-scanner">
        <span class="nav-icon">📷</span>
        <span>Scanner QR/Barras</span>
      </a>
      <a class="nav-item" data-page="categories" id="nav-categories">
        <span class="nav-icon">🏷️</span>
        <span>Categorias</span>
      </a>
      <a class="nav-item" data-page="catalog" id="nav-catalog">
        <span class="nav-icon">📚</span>
        <span>Catálogo</span>
      </a>
      <a class="nav-item" data-page="history" id="nav-history">
        <span class="nav-icon">📜</span>
        <span>Histórico</span>
      </a>
      <a class="nav-item" data-page="reports" id="nav-reports">
        <span class="nav-icon">📈</span>
        <span>Relatórios</span>
      </a>
      <a class="nav-item" data-page="settings" id="nav-settings">
        <span class="nav-icon">⚙️</span>
        <span>Configurações</span>
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-user"><div class="user-avatar">CV</div><div class="user-info"><div class="user-name">ControlVald Pro</div>
          <div class="user-plan">✨ Premium</div></div></div><button onclick="handleLogout()" style="background:transparent; border:1px solid var(--border); color:var(--text-2); padding:5px 10px; border-radius:8px; cursor:pointer; width:100%; text-align:center; font-size:0.8rem; display:flex; align-items:center; justify-content:center; gap:5px; margin-top:10px;">🚪 Sair</button></div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">

    <!-- TOP BAR -->
    <header class="topbar">
      <button class="menu-toggle" id="menuToggle">☰</button>
      <div class="topbar-title" id="pageTitle" style="display:none;"></div><div id="topbarClock" class="topbar-clock" style="font-family:'Courier New', moNãospace; font-weight:900; color:var(--primary); font-size:1rem; margin-right:auto; margin-left:10px; text-shadow:0 0 10px var(--primary-dim);">00:00:00</div>
      <div class="topbar-actions">
        <select id="globalLocationFilter" class="select-styled" style="max-width: 150px;">
          <option value="all">Todas as Lojas</option>
        </select>
        <div class="search-bar">
          <span class="search-icon">🔍</span>
          <input type="text" id="globalSearch" placeholder="Buscar produto..." autocomplete="off"/>
        </div>
        <button class="btn-primary-top" id="addProductBtn">+ Adicionar</button>
      </div>
    </header>

    <!-- PAGES -->
    <div class="page-content">

      <!-- ===== DASHBOARD ===== -->
      <section class="page active" id="page-dashboard">
        <div class="dashboard-greeting">
          <div style="text-align:center;">
            <h2 class="greeting-text" id="greetingText">Bom dia! 👋</h2>
            <p class="greeting-sub" style="text-align:center;">Aqui está o resumo do seu estoque hoje, <span id="todayDate"></span></p>
          </div>
        </div>

        <!-- STAT CARDS -->
        <div class="stats-grid">
          <div class="stat-card stat-total" onclick="navigate('products')">
            <div class="stat-icon-sm">📦</div>
            <div class="stat-num" id="stat-total">0</div>
            <div class="stat-lbl">Total</div>
          </div>
          <div class="stat-card stat-ok" onclick="navigate('products')">
            <div class="stat-icon-sm">✅</div>
            <div class="stat-num" id="stat-ok">0</div>
            <div class="stat-lbl">Validade</div>
          </div>
          <div class="stat-card stat-warn" onclick="navigate('alerts')">
            <div class="stat-icon-sm">⚠️</div>
            <div class="stat-num" id="stat-warn">0</div>
            <div class="stat-lbl">Breve</div>
          </div>
          <div class="stat-card stat-expired" onclick="navigate('alerts')">
            <div class="stat-icon-sm">❌</div>
            <div class="stat-num" id="stat-expired">0</div>
            <div class="stat-lbl">Vencidos</div>
          </div>
        </div>

        <!-- URGENT ALERTS -->
        <div class="section-header">
          <h3>🚨 Alertas Urgentes</h3>
          <a class="see-all" data-page="alerts">Ver todos</a>
        </div>
        <div class="alerts-list" id="urgentAlertsList">
          <div class="empty-state-small">Nenhum alerta urgente 🎉</div>
        </div>

        <!-- CHART + RECENT -->
        <div class="dashboard-bottom-grid">
          <div class="chart-card">
            <div class="chart-header">
              <h3>Distribuição por Status</h3>
            </div>
            <div class="donut-container">
              <canvas id="statusChart" width="200" height="200"></canvas>
              <div class="donut-center">
                <div class="donut-num" id="donutTotal">0</div>
                <div class="donut-label">Produtos</div>
              </div>
            </div>
            <div class="chart-legend" id="chartLegend"></div>
          </div>

          <div class="recent-card">
            <div class="chart-header">
              <h3>Adicionados Recentemente</h3>
            </div>
            <div class="recent-list" id="recentList">
              <div class="empty-state-small">Nenhum produto ainda</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== PRODUCTS ===== -->
      <section class="page" id="page-products">
      </a>
      <a class="nav-item" data-page="products" id="nav-products">
        <span class="nav-icon">📦</span>
        <span>Produtos</span>
        <span class="nav-badge" id="badge-products">0</span>
      </a>
      <a class="nav-item" data-page="alerts" id="nav-alerts">
        <span class="nav-icon">🔔</span>
        <span>Alertas</span>
        <span class="nav-badge danger" id="badge-alerts">0</span>
      </a>
      <a class="nav-item" data-page="scanner" id="nav-scanner">
        <span class="nav-icon">📷</span>
        <span>Scanner QR/Barras</span>
      </a>
      <a class="nav-item" data-page="categories" id="nav-categories">
        <span class="nav-icon">🏷️</span>
        <span>Categorias</span>
      </a>
      <a class="nav-item" data-page="catalog" id="nav-catalog">
        <span class="nav-icon">📚</span>
        <span>Catálogo</span>
      </a>
      <a class="nav-item" data-page="history" id="nav-history">
        <span class="nav-icon">📜</span>
        <span>Histórico</span>
      </a>
      <a class="nav-item" data-page="reports" id="nav-reports">
        <span class="nav-icon">📈</span>
        <span>Relatórios</span>
      </a>
      <a class="nav-item" data-page="settings" id="nav-settings">
        <span class="nav-icon">⚙️</span>
        <span>Configurações</span>
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-user"><div class="user-avatar">CV</div><div class="user-info"><div class="user-name">ControlVald Pro</div>
          <div class="user-plan">✨ Premium</div></div></div><button onclick="handleLogout()" style="background:transparent; border:1px solid var(--border); color:var(--text-2); padding:5px 10px; border-radius:8px; cursor:pointer; width:100%; text-align:center; font-size:0.8rem; display:flex; align-items:center; justify-content:center; gap:5px; margin-top:10px;">🚪 Sair</button></div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">

    <!-- TOP BAR -->
    <header class="topbar">
      <button class="menu-toggle" id="menuToggle">☰</button>
      <div class="topbar-title" id="pageTitle" style="display:none;"></div><div id="topbarClock" class="topbar-clock" style="font-family:'Courier New', moNãospace; font-weight:900; color:var(--primary); font-size:1rem; margin-right:auto; margin-left:10px; text-shadow:0 0 10px var(--primary-dim);">00:00:00</div>
      <div class="topbar-actions">
        <select id="globalLocationFilter" class="select-styled" style="max-width: 150px;">
          <option value="all">Todas as Lojas</option>
        </select>
        <div class="search-bar">
          <span class="search-icon">🔍</span>
          <input type="text" id="globalSearch" placeholder="Buscar produto..." autocomplete="off"/>
        </div>
        <button class="btn-primary-top" id="addProductBtn">+ Adicionar</button>
      </div>
    </header>

    <!-- PAGES -->
    <div class="page-content">

      <!-- ===== DASHBOARD ===== -->
      <section class="page active" id="page-dashboard">
        <div class="dashboard-greeting">
          <div style="text-align:center;">
            <h2 class="greeting-text" id="greetingText">Bom dia! 👋</h2>
            <p class="greeting-sub" style="text-align:center;">Aqui está o resumo do seu estoque hoje, <span id="todayDate"></span></p>
          </div>
        </div>

        <!-- STAT CARDS -->
        <div class="stats-grid">
          <div class="stat-card stat-total" onclick="navigate('products')">
            <div class="stat-icon-sm">📦</div>
            <div class="stat-num" id="stat-total">0</div>
            <div class="stat-lbl">Total</div>
          </div>
          <div class="stat-card stat-ok" onclick="navigate('products')">
            <div class="stat-icon-sm">✅</div>
            <div class="stat-num" id="stat-ok">0</div>
            <div class="stat-lbl">Validade</div>
          </div>
          <div class="stat-card stat-warn" onclick="navigate('alerts')">
            <div class="stat-icon-sm">⚠️</div>
            <div class="stat-num" id="stat-warn">0</div>
            <div class="stat-lbl">Breve</div>
          </div>
          <div class="stat-card stat-expired" onclick="navigate('alerts')">
            <div class="stat-icon-sm">❌</div>
            <div class="stat-num" id="stat-expired">0</div>
            <div class="stat-lbl">Vencidos</div>
          </div>
        </div>

        <!-- URGENT ALERTS -->
        <div class="section-header">
          <h3>🚨 Alertas Urgentes</h3>
          <a class="see-all" data-page="alerts">Ver todos</a>
        </div>
        <div class="alerts-list" id="urgentAlertsList">
          <div class="empty-state-small">Nenhum alerta urgente 🎉</div>
        </div>

        <!-- CHART + RECENT -->
        <div class="dashboard-bottom-grid">
          <div class="chart-card">
            <div class="chart-header">
              <h3>Distribuição por Status</h3>
            </div>
            <div class="donut-container">
              <canvas id="statusChart" width="200" height="200"></canvas>
              <div class="donut-center">
                <div class="donut-num" id="donutTotal">0</div>
                <div class="donut-label">Produtos</div>
              </div>
            </div>
            <div class="chart-legend" id="chartLegend"></div>
          </div>

          <div class="recent-card">
            <div class="chart-header">
              <h3>Adicionados Recentemente</h3>
            </div>
            <div class="recent-list" id="recentList">
              <div class="empty-state-small">Nenhum produto ainda</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== PRODUCTS ===== -->
      <section class="page" id="page-products">
        <div class="products-toolbar">
          <div class="filter-tabs">
            <button class="filter-tab active" data-filter="all">Todos</button>
            <button class="filter-tab" data-filter="ok">✅ Na Validade</button>
            <button class="filter-tab" data-filter="warn">⚠️ Atenção</button>
            <button class="filter-tab" data-filter="expired">❌ Vencidos</button>
          </div>
          <div class="products-right-actions">
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:10px;">
              <button class="btn-outline" id="exportBtn">⬇ JSON</button>
              <button class="btn-outline" id="exportCsvBtn">📊 CSV</button>
              <button class="btn-outline" id="importBtn">⬆ JSON</button>
              <button class="btn-outline" id="importExcelBtn">📗 Excel</button>
              <input type="file" id="importFile" accept=".json" style="display:none"/>
              <input type="file" id="importExcelFile" accept=".xlsx,.xls" style="display:none"/>
            </div>
      <!-- ===== REPORTS ===== -->
      <section class="page" id="page-reports">
        <div class="reports-grid">
          <div class="report-card">
            <div class="report-icon">📊</div>
            <h3>Relatório Mensal</h3>
            <p>Produtos vencidos e válidos por mês</p>
            <canvas id="monthlyChart" width="300" height="160"></canvas>
          </div>
          <div class="report-card">
            <div class="report-icon">🏷️</div>
            <h3>Por Categoria</h3>
            <p>Distribuição de produtos</p>
            <canvas id="categoryChart" width="300" height="160"></canvas>
          </div>
          <div class="report-card full-width">
            <div class="report-icon">⚡</div>
            <h3>Linha do Tempo</h3>
            <p>Produtos com vencimento próximo Nãos próximos 60 dias</p>
            <div class="timeline-list" id="timelineList"></div>
          </div>
        </div>
      </section>

      <!-- ===== SETTINGS ===== -->
      <section class="page" id="page-settings">
        <div class="settings-grid">
          <div class="settings-card">
            <h3>🔔 Nãotificações</h3>
            <div class="setting-item">
              <label>Alertar com antecedência de</label>
              <div class="setting-control">
                <input type="number" id="warnDays" value="7" min="1" max="90" class="input-small"/>
                <span>dias</span>
              </div>
            </div>
            <div class="setting-item">
              <label>Alertas críticos</label>
              <div class="setting-control">
                <input type="number" id="critDays" value="3" min="1" max="30" class="input-small"/>
                <span>dias</span>
              </div>
            </div>
            <div class="setting-item">
              <label>Nãotificações do navegador</label>
              <div class="setting-control">
                <label class="toggle">
                  <input type="checkbox" id="NãotifToggle"/>
                  <span class="toggle-slider"></span>
                </label>
              </div>
            </div>
          </div>

          <div class="settings-card">
            <h3>🎨 Aparência</h3>
            <div class="setting-item">
              <label>Tema</label>
              <div class="setting-control">
                <select id="themeSelect" class="select-styled">
                  <option value="dark">🌙 Dark (Padrão)</option>
                  <option value="darker">⚫ Ultra Dark</option>
                  <option value="purple">💜 Purple Night</option>
                  <option value="green">💚 Matrix Green</option>
                  <option value="light">☀️ Light Mode</option>
                </select>
              </div>
            </div>
            <div class="setting-item">
              <label>Animações</label>
              <div class="setting-control">
                <label class="toggle">
                  <input type="checkbox" id="animToggle" checked/>
                  <span class="toggle-slider"></span>
                </label>
              </div>
            </div>
          </div>

          <div class="settings-card">
            <h3>💾 Dados</h3>
            <div class="setting-item">
              <label>Exportar todos os dados</label>
              <div class="setting-control">
                <button class="btn-outline" id="exportAllBtn">⬇ Exportar JSON</button>
                <button class="btn-outline" id="exportCsvAllBtn">📊 Exportar CSV</button>
              </div>
            </div>
            <div class="setting-item">
              <label>Importar dados</label>
              <div class="setting-control">
                <button class="btn-outline" id="importAllBtn">⬆ Importar JSON</button>
                <button class="btn-outline" id="importExcelAllBtn">📗 Importar Excel</button>
                <input type="file" id="importAllFile" accept=".json" style="display:none"/>
                <input type="file" id="importExcelAllFile" accept=".xlsx,.xls" style="display:none"/>
              </div>
            </div>
            <div class="setting-item">
              <label>Limpar todos os dados</label>
              <div class="setting-control">
                <button class="btn-danger-outline" id="clearAllBtn">🗑 Limpar Tudo</button>
              </div>
            </div>
          </div>

          <div class="settings-card">
            <h3>ℹ️ Sobre</h3>
            <div class="about-info">
              <div class="about-logo">Control<span>Vald</span></div>
              <div class="about-version">Versão 1.0.0 Premium</div>
              <div class="about-desc">O app de controle de validade mais avançado do mercado. Gestão inteligente, alertas em tempo real e scanner integrado.</div>
            </div>
          </div>
        </div>
      </section>

    </div><!-- /page-content -->
  </main><!-- /main-content -->
</div><!-- /app -->

<!-- BOTTOM NAV (mobile only) -->
<nav class="bottom-nav" id="bottomNav">
  <a class="bottom-nav-item active" data-page="dashboard" id="bnav-dashboard">
    <span class="bnav-icon">📊</span>
    <span class="bnav-label">Dashboard</span>
  </a>
  <a class="bottom-nav-item" data-page="products" id="bnav-products">
    <span class="bnav-icon">📦</span>
    <span class="bnav-label">Produtos</span>
  </a>
  <a class="bottom-nav-item" data-page="alerts" id="bnav-alerts">
    <span class="bnav-icon">🔔</span>
    <span class="bnav-label">Alertas</span>
    <span class="bnav-badge" id="bnav-badge-alerts"></span>
  </a>
  <a class="bottom-nav-item" data-page="catalog" id="bnav-catalog">
    <span class="bnav-icon">📚</span>
    <span class="bnav-label">Catálogo</span>
  </a>
  <a class="bottom-nav-item" data-page="settings" id="bnav-settings">
    <span class="bnav-icon">⚙️</span>
    <span class="bnav-label">Config</span>
  </a>
</nav>

<!-- MODAL: ADD/EDIT PRODUCT -->
<div class="modal-overlay hidden" id="productModal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="modalTitle">Nãovo Produto</h2>
      <button class="modal-close" id="modalClose">✕</button>
    </div>
    <div class="modal-body" style="overflow-y:auto; max-height:65vh;">
      <div class="form-row" id="prodImageContainer" style="display:none; justify-content:center; margin-bottom:15px; flex-direction:column; align-items:center; gap:10px;">
       <img id="prodImage" src="" alt="Foto" style="max-height:120px; border-radius:8px; object-fit:contain;"/>
       <img id="prodBarcodeImage" src="" alt="Barcode" onerror="this.style.display='none'" style="max-height:40px; border-radius:4px; object-fit:contain; background:white; padding:4px;"/>
     </div>
      <div id="prodNãotFoundMsg" style="display:none; color: var(--primary); text-align:center; font-weight:bold; margin-bottom:10px;">
        Produto não encontrado.
      </div>
      <div style="text-align:center; margin-bottom:15px; display:none;" id="btnGoCatalogContainer">
        <button class="btn-outline" id="btnGoCatalog">Cadastrar Nãovo produto</button>
      </div>
      <div class="form-row">
        <div class="form-group full-width">
          <label>Nãome do Produto *</label>
          <input type="text" id="prodName" placeholder="Ex: Leite Integral 1L" class="input-styled" required/>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Código de Barras / EAN</label>
          <div class="input-with-btn">
            <input type="text" id="prodCode" placeholder="Ex: 7891025113447" class="input-styled" inputmode="numeric"/>
            <button class="btn-icon-sm" id="scanFromModal" title="Escanear código de barras com a câmera">📷</button>
          </div>
          <!-- Scanner inline dentro do modal -->
          <div id="inlineScannerContainer" style="display:none; margin-top:10px; border-radius:10px; overflow:hidden; position:relative;">
            <div id="inlineScannerDiv" style="width:100%; height:240px;"></div>
            <button id="stopInlineScanBtn" style="position:absolute; top:8px; right:8px; background:rgba(0,0,0,0.7); color:#fff; border:none; border-radius:50%; width:32px; height:32px; cursor:pointer; font-size:1rem;">✕</button>
          </div>
        </div>
        <div class="form-group">
          <label>Categoria</label>
          <select id="prodCategory" class="select-styled">
            <option value="">Selecionar...</option>
          </select>
          <label style="display:flex; align-items:center; gap:0.5rem; margin-top:0.5rem; cursor:pointer;">
            <input type="checkbox" id="prodAutoCategory" checked />
            <span style="font-size:0.85rem; color:#94A3B8;">Auto-categorizar pelo Nãome</span>
          </label>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Data de Fabricação</label>
          <input type="date" id="prodMfgDate" class="input-styled"/>
        </div>
        <div class="form-group">
          <label>Data de Validade *</label>
          <input type="date" id="prodExpDate" class="input-styled" required/>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Quantidade</label>
          <input type="number" id="prodQty" value="1" min="1" class="input-styled"/>
        </div>
        <div class="form-group">
          <label>Cadastrar/Loja</label>
          <div class="input-with-btn">
            <select id="prodLocation" class="select-styled">
              <option value="">Cadastrar</option>
            </select>
            <button class="btn-icon-sm" id="addStoreBtn" title="Nãova Loja">➕</button>
            <button class="btn-icon-sm" id="deleteStoreBtn" title="Excluir Loja" style="background: rgba(239, 68, 68, 0.1); color: var(--primary); border-color: rgba(239, 68, 68, 0.2);">🗑</button>
          </div>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group full-width">
          <label>Observações</label>
          <textarea id="prodNãotes" placeholder="Nãotas adicionais..." class="input-styled" rows="2"></textarea>
        </div>
      </div>
      <!-- Expiry Gauge -->
      <div class="expiry-preview hidden" id="expiryPreview">
        <div class="expiry-gauge">
          <div class="gauge-label" id="gaugeLabel">—</div>
          <div class="gauge-bar">
            <div class="gauge-fill" id="gaugeFill"></div>
          </div>
          <div class="gauge-sub" id="gaugeSub"></div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" id="modalCancel">Cancelar</button>
      <button class="btn-primary" id="modalSave">💾 Salvar Produto</button>
    </div>
  </div>
</div>

<!-- MODAL: CATEGORY -->
<div class="modal-overlay hidden" id="categoryModal">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h2>Nãova Categoria</h2>
      <button class="modal-close" id="catModalClose">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-group full-width">
        <label>Nãome da Categoria</label>
        <input type="text" id="catName" placeholder="Ex: Laticínios" class="input-styled"/>
      </div>
      <div class="form-group full-width">
        <label>Emoji / Ícone</label>
        <div class="emoji-picker" id="emojiPicker">
          <span class="emoji-opt selected" data-emoji="📦">📦</span>
          <span class="emoji-opt" data-emoji="🥛">🥛</span>
          <span class="emoji-opt" data-emoji="🥩">🥩</span>
          <span class="emoji-opt" data-emoji="🥗">🥗</span>
          <span class="emoji-opt" data-emoji="🍞">🍞</span>
          <span class="emoji-opt" data-emoji="🧴">🧴</span>
          <span class="emoji-opt" data-emoji="💊">💊</span>
          <span class="emoji-opt" data-emoji="🧹">🧹</span>
          <span class="emoji-opt" data-emoji="🍷">🍷</span>
          <span class="emoji-opt" data-emoji="🌿">🌿</span>
          <span class="emoji-opt" data-emoji="🧊">🧊</span>
          <span class="emoji-opt" data-emoji="🍫">🍫</span>
        </div>
        <input type="text" id="catEmoji" value="📦" class="input-styled" style="width:80px; text-align:center; font-size:1.5rem; margin-top:0.5rem;"/>
      </div>
      <div class="form-group full-width">
        <label>Cor</label>
        <div class="color-picker" id="colorPicker">
          <span class="color-opt selected" data-color="#6EE7B7" style="background:#6EE7B7"></span>
          <span class="color-opt" data-color="#3B82F6" style="background:#3B82F6"></span>
          <span class="color-opt" data-color="#A78BFA" style="background:#A78BFA"></span>
          <span class="color-opt" data-color="#F59E0B" style="background:#F59E0B"></span>
          <span class="color-opt" data-color="#EF4444" style="background:#EF4444"></span>
          <span class="color-opt" data-color="#EC4899" style="background:#EC4899"></span>
          <span class="color-opt" data-color="#06B6D4" style="background:#06B6D4"></span>
          <span class="color-opt" data-color="#F97316" style="background:#F97316"></span>
        </div>
        <input type="color" id="catColor" value="#6EE7B7" class="input-styled" style="width:80px; height:40px; padding:4px; margin-top:0.5rem;"/>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" id="catCancel">Cancelar</button>
      <button class="btn-primary" id="catSave">Salvar</button>
    </div>
  </div>
</div>

<!-- MODAL: CAMERA SCANNER -->
<div class="modal-overlay hidden" id="scannerModal">
  <div class="modal" style="display:flex; flex-direction:column; padding:0; height:80vh; max-height:800px;">
    <div class="modal-header" style="padding:15px; border-bottom: 1px solid var(--border);">
      <h2>Escanear Código</h2>
      <button class="modal-close" id="scannerClose">✕</button>
    </div>
    <div class="modal-body" style="flex:1; overflow:hidden; padding:0; display:flex; justify-content:center; align-items:center; background:#000;">
      <div id="reader" style="width:100%; height:100%;"></div>
    </div>
  </div>
</div>

<!-- CONFIRM DIALOG -->
<div class="modal-overlay hidden" id="confirmModal">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h2 id="confirmTitle">Confirmar</h2>
      <button class="modal-close" id="confirmClose">✕</button>
    </div>
    <div class="modal-body">
      <p id="confirmMsg"></p>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" id="confirmNão">Cancelar</button>
      <button class="btn-danger" id="confirmYes">Confirmar</button>
    </div>
  </div>
</div>

<!-- TOAST NãoTIFICATION -->
<div class="toast hidden" id="toast">
  <span class="toast-icon" id="toastIcon">✅</span>
  <span id="toastMsg"></span>
</div>

<!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-messaging-compat.js"></script>

<!-- html5-qrcode (scanner página Scanner) -->
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<!-- Quagga2 (melhor leitura de código de barras 1D Não modal) -->
<script src="https://cdn.jsdelivr.net/npm/@ericblade/quagga2/dist/quagga.min.js"></script>
<!-- SheetJS para importar Excel -->
<script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>
<script src="app.js?v=3"></script>
</body>
</html>



