{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "prazocerto-app",
      "public": "www",
      "rewrites": [
        {
          "source": "/",
          "destination": "/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": {
    "source": "functions"
  }
}
